DOMAIN=learn.example.com
RAG_DATA_DIR=/srv/rag-data
BACKEND_IMAGE=ghcr.io/sakuralovesmile/studytool-connected-backend:0.1.0
FRONTEND_IMAGE=ghcr.io/sakuralovesmile/studytool-connected-frontend:0.1.0

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
OCR_MODE=vision_llm
OCR_BASE_URL=
OCR_API_KEY=
OCR_VISION_MODEL=gpt-4o-mini
OCR_TIMEOUT=120
# Independent OCR: set OCR_BASE_URL and OCR_API_KEY together.
# SiliconFlow: https://api.siliconflow.cn/v1, model PaddlePaddle/PaddleOCR-VL-1.5.
# To use Baidu instead, set OCR_MODE=paddleocr_api and its URL/Token below.
BAIDU_OCR_API_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
BAIDU_OCR_TOKEN=
EMBEDDING_MODE=remote
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
