APP_IMAGE=ghcr.io/sakuralovesmile/studytool:latest
APP_PORT=8088
PUBLIC_ORIGIN=https://learn.example.com
RAG_DATA_DIR=/srv/rag-data

LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=180

EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Baidu PaddleOCR: copy the Token from https://aistudio.baidu.com/paddleocr
# Use the jobs API URL here, not the console page URL above.
OCR_MODE=paddleocr_api
BAIDU_OCR_API_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
BAIDU_OCR_TOKEN=

# Optional OpenAI-compatible OCR (set OCR_MODE=vision_llm to use it):
# OCR_BASE_URL=https://api.siliconflow.cn/v1
# OCR_API_KEY=
# OCR_VISION_MODEL=PaddlePaddle/PaddleOCR-VL-1.5
# OCR_TIMEOUT=120
