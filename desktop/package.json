{
  "name": "studytool",
  "version": "1.0.7-beta.1",
  "description": "学习助手 Windows 桌面版",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/tests/*.test.js tests/*.test.js",
    "test:patch": "node --test tests/*.test.js",
    "test:stress": "node --expose-gc --test dist/stress/*.test.js",
    "test:ui": "electron scripts/verify-logs-ui-timing.js",
    "start": "electron dist/main.js",
    "pack": "electron-builder --win --x64",
    "release": "python scripts/build-release.py"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "electron": "^33.2.1",
    "electron-builder": "25.1.8",
    "typescript": "~5.6.3"
  }
}
