{
  appId: "com.studytool.connected.windows",
  productName: "StudyTool Connected",
  directories: { output: "release" },
  beforePack: "./scripts/patch-nsis-template.js",
  files: ["src/**/*", "package.json"],
  win: { target: [{ target: "nsis", arch: ["x64"] }] },
  nsis: {
    artifactName: "studytool-connected-setup-${version}-${arch}.${ext}",
    oneClick: false,
    perMachine: false,
    allowToChangeInstallationDirectory: true,
    deleteAppDataOnUninstall: false,
    createDesktopShortcut: true,
    createStartMenuShortcut: true,
    shortcutName: "StudyTool Connected"
  }
}
