# Backend Server Config
HOST=127.0.0.1
PORT=8000
DATA_DIR=./data

# Logging & Diagnostics Configuration
LOG_LEVEL=INFO
LOG_DIR=
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# LLM API Configuration (Compatible with OpenAI / 通义千问 / DeepSeek / Moonshot / Ollama)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60
# Set true only for local demo/test data. Formal imports require real OCR/LLM results.
DEMO_MODE=false

# OCR Configuration
# Modes: "local" (PaddleOCR/RapidOCR if available), "vision_llm" (using LLM_BASE_URL + Vision model), "mock" (demo only)
OCR_MODE=vision_llm
OCR_VISION_MODEL=gpt-4o-mini
OCR_API_KEY=
OCR_BASE_URL=

# Embedding Configuration
# Modes: "mock" (offline hash/tfidf-like embedding), "remote" (OpenAI / text-embedding-3-small)
EMBEDDING_MODE=mock
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
