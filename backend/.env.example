# Backend Server Config
HOST=127.0.0.1
PORT=8000
DATA_DIR=./data

# Logging & Diagnostics Configuration
LOG_LEVEL=INFO
LOG_DIR=
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# LLM API Configuration (Compatible with OpenAI / 通义千问 / DeepSeek / Moonshot / Ollama)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60
# Set true only for local demo/test data. Formal imports require real OCR/LLM results.
DEMO_MODE=false

# OCR Configuration
# Modes: "paddleocr_api" (Baidu asynchronous jobs), "vision_llm" (vision model), "mock" (explicit demo only)
OCR_MODE=vision_llm
OCR_VISION_MODEL=gpt-4o-mini
OCR_API_KEY=
OCR_BASE_URL=
OCR_TIMEOUT=120
# SiliconFlow example: OCR_MODE=vision_llm, OCR_BASE_URL=https://api.siliconflow.cn/v1,
# OCR_VISION_MODEL=PaddlePaddle/PaddleOCR-VL-1.5, OCR_API_KEY=<your SiliconFlow key>.
# Set both OCR_BASE_URL and OCR_API_KEY for a dedicated OCR service.
# For Baidu OCR, set OCR_MODE=paddleocr_api and fill the AI Studio Access Token.
BAIDU_OCR_API_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
BAIDU_OCR_TOKEN=

# Embedding Configuration
# Modes: "mock" (offline hash/tfidf-like embedding), "remote" (OpenAI / text-embedding-3-small)
EMBEDDING_MODE=mock
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
